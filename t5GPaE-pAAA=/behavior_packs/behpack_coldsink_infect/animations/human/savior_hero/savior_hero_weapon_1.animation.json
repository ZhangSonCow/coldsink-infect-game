{
  "format_version": "1.8.0",
  "animations": {
    "animation.savior_hero_weapon_1_fire.func": {
      "loop": false,
      "animation_length": 10.0,
      "timeline": {
        "0.06": [
          "/event entity @s action_clear"
        ]
      }
    },
    "animation.savior_hero_weapon_1_loading.func": {
      "loop": false,
      "animation_length": 10.0,
      "timeline": {
        "0.0": [
          "/tag @s add self",

          "/replaceitem entity @s[scores={bullet_hero=..59}] slot.weapon.mainhand 1 coldsink:savior_hero_weapon_1_empty 1 0 {\"item_lock\":{\"mode\":\"lock_in_slot\"}}",
          "/title @s[scores={bullet_hero=..59}] actionbar §6Reloading...",
          "/execute @s[scores={bullet_hero=..59}] ~~~ playsound savior_hero_weapon_1.reload @a[tag=!self] ~~~",
          "/playsound savior_hero_weapon_1.reload.self @s[scores={bullet_hero=..59}]",
          
          "/tag @s remove self"
        ],
        "2.5": [
          // 【地图】

          // 计算备弹是否能填满主弹夹
          "/scoreboard players set @s[tag=!bullet_infinite,tag=maper] bullet_need 60",
          "/scoreboard players operation @s[tag=!bullet_infinite,tag=maper] bullet_need -= @s bullet_hero",
          "/scoreboard players operation @s[tag=!bullet_infinite,tag=maper] bullet_query = @s bullet_back",
          "/scoreboard players operation @s[tag=!bullet_infinite,tag=maper] bullet_query -= @s bullet_need",
          // 备弹够填满主弹夹
          "/scoreboard players set @s[tag=!bullet_infinite,tag=maper,scores={bullet_query=0..}] bullet_hero 60",
          "/scoreboard players operation @s[tag=!bullet_infinite,tag=maper,scores={bullet_query=0..}] bullet_back -= @s bullet_need",
          // 备弹不够填满主弹夹
          "/scoreboard players operation @s[tag=!bullet_infinite,tag=maper,scores={bullet_query=..-1}] bullet_hero += @s bullet_back",
          "/scoreboard players set @s[tag=!bullet_infinite,tag=maper,scores={bullet_query=..-1}] bullet_back 0",
          "/titleraw @s[tag=!bullet_infinite,tag=maper] actionbar {\"rawtext\":[{\"text\":\"§f< §6\"},{\"score\":{\"name\":\"@s\",\"objective\":\"bullet_hero\"}},{\"text\":\"§f / §6\"},{\"score\":{\"name\":\"@s\",\"objective\":\"bullet_back\"}},{\"text\":\"§f >\"}]}",

          // 【模组】

          "/scoreboard players set @s[tag=maper] bullet_hero 60",
          "/titleraw @s[tag=maper] actionbar {\"rawtext\":[{\"text\":\"§f< §6\"},{\"score\":{\"name\":\"@s\",\"objective\":\"bullet_hero\"}},{\"text\":\"§f / §660\"},{\"text\":\"§f >\"}]}",

          // 【无限子弹】

          "/scoreboard players set @s[tag=bullet_infinite] bullet_hero 60",
          "/titleraw @s[tag=bullet_infinite] actionbar {\"rawtext\":[{\"text\":\"§f< §6\"},{\"score\":{\"name\":\"@s\",\"objective\":\"bullet_hero\"}},{\"text\":\"§f / §660\"},{\"text\":\"§f >\"}]}",
          
          "/event entity @s action_clear"
        ]
      }
    }
  }
}
