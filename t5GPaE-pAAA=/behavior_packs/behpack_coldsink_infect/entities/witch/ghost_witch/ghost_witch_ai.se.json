        "add": {
          "component_groups": [
            "shoot_now"
          ]
        }
      },
      "skill_tp": {
        "queue_command": {
          "command": [
            "scoreboard players operation @e[type=coldsink:ghost_light_sign_ai] witch_check = @s witch_time",
            "execute @e[type=coldsink:ghost_light_sign_ai] ~~~ scoreboard players operation @s witch_check -= @s witch_time",
            "execute @e[type=coldsink:ghost_light_sign_ai,scores={witch_check=0},c=1] ~~~ playsound ghost.witch.skill_end @a[r=16] ~~~",

            "execute @s[tag=maper] ~~~ execute @e[type=coldsink:ghost_light_sign_ai,scores={witch_check=0},c=1] ~~~ effect @e[family=player,family=!tool,type=!item,tag=!neutral,r=8] slowness 4 1 true",
            "execute @s[tag=maper] ~~~ execute @e[type=coldsink:ghost_light_sign_ai,scores={witch_check=0},c=1] ~~~ title @a[family=player,family=!tool,tag=!neutral,r=8] actionbar §b【幽鬼女巫】 §f已来袭",
            "tp @s[tag=maper] @e[type=coldsink:ghost_light_sign_ai,scores={witch_check=0},c=1]",

            "tag @s[tag=!maper] add ghost_tp_self",
            "execute @s[tag=!maper] ~~~ execute @e[type=coldsink:ghost_light_sign_ai,scores={witch_check=0},c=1] ~~~ effect @e[tag=!ghost_tp_self,family=!tool,type=!item,tag=!neutral,r=8] slowness 4 1 true",
            "execute @s[tag=!maper] ~~~ execute @e[type=coldsink:ghost_light_sign_ai,scores={witch_check=0},c=1] ~~~ title @a[tag=!ghost_tp_self,family=!tool,tag=!neutral,r=8] actionbar §b【幽鬼女巫】 §f已来袭",
            "tp @s[tag=!maper] @e[type=coldsink:ghost_light_sign_ai,scores={witch_check=0},c=1]",
            "tag @s[tag=!maper] remove ghost_tp_self",

            "execute @e[type=coldsink:ghost_light_sign_ai,scores={witch_check=0},c=1] ~~~ particle nacal_sdc:ghost_witch_appear ~~~",

            "event entity @e[type=coldsink:ghost_light_sign_ai,scores={witch_check=0},c=1] godie"
          ]
        }
      },
      "godie": {
        "add": {
          "component_groups": [
            "godie"
          ]
        }
      },
      "melee_tag": {
