{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "coldsink:ghost_witch_ai",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false,
      "animations": {
        "c": "controller.animation.ghost_witch_ai.func",
        "sound_interval": "animation.sfzombie_sound_interval.func"
      },
      "scripts": {
        "animate": [
          "c",
          "sound_interval"
        ]
      }
    },

    "component_groups": {
      "godie": {
        "minecraft:instant_despawn": {}
      },
      "shoot_now": {
        "minecraft:is_ignited": {},
        "minecraft:behavior.ranged_attack": {
          "priority": 0,
          "attack_interval": 1,
          "attack_radius": 64
        }
      },
      "skill": {
        "minecraft:is_sheared": {},
        "minecraft:ageable": {
          "duration": 0.5,
          "grow_up": {
            "event": "cooldown"
          }
        }
      },
      "cooldown": {
        "minecraft:ageable": {
          "duration": 7.5,
          "grow_up": {
            "event": "charged"
          }
        },
        "minecraft:behavior.melee_attack": {
          "priority": 0,
          "track_target": true
        }
      },
      "damage_1": {
        "minecraft:attack": {
          "damage": 3
        }
      },
      "damage_2": {
        "minecraft:attack": {
          "damage": 4
        }
      },
      "damage_3": {
        "minecraft:attack": {
          "damage": 5
        }
      },
      "damage_4": {
        "minecraft:attack": {
          "damage": 6
        }
      },
      "damage_5": {
        "minecraft:attack": {
          "damage": 7
        }
      },
      "lets_move": {
        "minecraft:behavior.delayed_attack": {
          "priority": 0,
          "attack_once": false,
          "track_target": true,
          "require_complete_path": false,
          "random_stop_interval": 0,
          "reach_multiplier": 5,
          "speed_multiplier": 1,
          "attack_duration": 0.8,
          "hit_delay_pct": 0.4
        }
      },
      "walk": {
        "minecraft:navigation.walk": {
          "can_walk": true,
          "can_pass_doors": true,
          "can_break_doors": true,
          "is_amphibious": true,
          "avoid_damage_blocks": false
        }
      },
      "climb": {
        "minecraft:navigation.climb": {
          "can_path_over_water": true,
          "blocks_to_avoid": [
            "minecraft:barrier"
          ]
        },
        "minecraft:behavior.leap_at_target": {
          "priority": 3,
          "must_be_on_ground": true,
          "set_persistent": true,
          "target_dist": 128,
          "yd": 0.6
        }
      },
      "attack_mode": {
        "minecraft:behavior.nearest_prioritized_attackable_target": {
          "priority": 2,
          "within_radius": 64,
          "reselect_targets": true,
          "scan_interval": 64,
          "must_see": false,
          "must_see_forget_duration": 8.0,
          "entity_types": [
            {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "final_box_red"
                  }
                ]
              },
              "max_dist": 32,
              "priority": 0,
              "must_see": true
            },
            {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "!=",
                    "value": "tool"
                  },
                  {
                    "test": "has_tag",
                    "subject": "other",
                    "operator": "!=",
                    "value": "neutral"
                  },
                  {
                    "test": "has_tag",
                    "subject": "other",
                    "operator": "!=",
                    "value": "no_any_hurt"
                  }
                ]
              },
              "max_dist": 64,
              "priority": 1,
              "must_see": false
            }
          ]
        }
      },
      "get_box_mode": {
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 2,
          "reselect_targets": true,
          "scan_interval": 50,
          "entity_types": [
            {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "=",
                    "value": "final_box_red"
                  }
                ]
              },
              "max_dist": 48
            }
          ],
          "must_see": true
        }
      }
    },

    "components": {
      "minecraft:nameable": {
        "always_show": true,
        "allow_name_tag_renaming": false
      },
      "minecraft:type_family": {
        "family": [ "mob", "sdc", "monster", "special", "ghost_witch", "boss", "final_boss", "ai" ]
      },
      "minecraft:health": {
        "value": 80,
        "max": 80
      },
      "minecraft:knockback_resistance": {
        "value": 0.99
      },
      "minecraft:timer": {
        "time": [5, 24],
        "time_down_event": {
          "event": "skill_tp",
          "target": "self"
        }
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "on_damage": {
              "filters": [
                {
                  "test":"has_damage",
                  "value":"fatal",
                  "operator": "!="
                }
              ],
              "event": "hurting",
              "target": "self"
            }
          },
          {
            "on_damage": {
              "filters": {
                "all_of": [
                  {
                    "test":"has_damage",
                    "value":"fatal",
                    "operator": "="
                  },
                  {
                    "test": "has_tag",
                    "subject": "other",
                    "value": "is_hero"
                  },
                  {
                    "test": "has_damage",
                    "operator": "!=",
                    "value": "projectile"
                  }
                ]
              },
              "event": "melee_tag",
              "target": "self"
            }
          },
          {
            "cause": "fall",
            "deals_damage": false
          }
        ]
      },
      "minecraft:attack": {
        "damage": 2
      },
      "minecraft:movement": {
        "value": 0.45
      },
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 2.0
      },
      "minecraft:follow_range": {
        "value": 1024
      },
      "minecraft:physics": {},
      "minecraft:jump.static": {},
      "minecraft:movement.basic": {},

      "minecraft:on_target_acquired": {
        "event": "has_target",
        "target": "self"
      },
      "minecraft:on_target_escape": {
        "event": "lost_target",
        "target": "self"
      },

      "minecraft:shooter": {
        "def": "coldsink:witch_lightball_ai"
      },
      "minecraft:target_nearby_sensor": {
        "inside_range": 11.0,
        "outside_range": 12.0,
        "on_inside_range": {
          "event": "nacal_sdc:close_enough",
          "target": "self"
        },
        "on_outside_range": {
          "event": "nacal_sdc:too_far",
          "target": "self"
        }
      },

      //behavivors


      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 0.8
      },
      "minecraft:behavior.random_look_around": {
        "priority": 7
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 6,
        "probability": 0.02
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1,
        "max_dist": 64,
        "entity_types": {
          "filters": {
            "all_of": [
              {
                "test": "is_family",
                "subject": "other",
                "operator": "!=",
                "value": "monster"
              },
              {
                "test": "is_family",
                "subject": "other",
                "operator": "!=",
                "value": "tool"
              },
              {
                "test": "has_tag",
                "subject": "other",
                "operator": "!=",
                "value": "neutral"
              }
            ]
          }
        }
      }
    },

    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "lets_move",
            "walk",
            "attack_mode"
          ]
        },
        "queue_command": {
          "command": [
            "tag @s add is_witch",
            "tag @s add 游戏中",
            "tag @s add maper",

            "scoreboard objectives add witch_time dummy witch_time",
            "scoreboard objectives add witch_check dummy witch_check",
            "scoreboard players add count witch_time 1",
            "scoreboard players operation @s witch_time = count witch_time",
            "execute @s[scores={witch_time=999..}] ~~~ scoreboard players set count witch_time 0"
          ]
        }
      },
      "nacal_sdc:close_enough": {
        "add": {
          "component_groups": [
            "shoot_now"
          ]
        },
        "remove": {
          "component_groups": [
            "lets_move"
          ]
        }
      },
      "nacal_sdc:too_far": {
        "add": {
          "component_groups": [
            "lets_move"
          ]
        },
        "remove": {
          "component_groups": [
            "shoot_now"
          ]
        }
      },
      "has_target": {
        "remove": {
          "component_groups": [
            "walk"
          ]
        },
        "add": {
          "component_groups": [
            "climb"
          ]
        }
      },
      "lost_target": {
        "remove": {
          "component_groups": [
            "climb"
          ]
        },
        "add": {
          "component_groups": [
            "walk"
          ]
        }
      },
      "hurting":{
        "queue_command": {
          "command": [
            "scoreboard players random @s[tag=!sound_interval] wp_random 1 3",

            "execute @s[tag=!sound_interval,scores={wp_random=1}] ~~~ playsound witch.hurt_1 @a ~~~",
            "execute @s[tag=!sound_interval,scores={wp_random=2}] ~~~ playsound witch.hurt_2 @a ~~~",
            "execute @s[tag=!sound_interval,scores={wp_random=3}] ~~~ playsound witch.hurt_3 @a ~~~",

            "scoreboard players reset @s[tag=!sound_interval] idle_time",
            "tag @s[tag=!sound_interval] add sound_interval"
          ]
        }
      },
      "damage_1": {
        "add": {
          "component_groups": [
            "damage_1"
          ]
