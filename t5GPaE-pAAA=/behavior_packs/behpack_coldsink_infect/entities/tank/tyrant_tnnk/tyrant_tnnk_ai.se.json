{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "coldsink:tyrant_tnnk_ai",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false,
      "animations": {
        "c": "controller.animation.tyrant_tnnk_ai.func",
        "c.walk": "controller.animation.tank_move_sound.func",
        "tank_move_sound": "animation.tank_move_sound.func",
        "sound_interval": "animation.sfzombie_sound_interval.func",
        "tyrant_tank_skill_timer": "animation.tyrant_tank_skill_timer.func",
        "c.tyrant_tank_buff_ai": "controller.animation.tyrant_tank_buff_ai.func",
        "tyrant_tank_buff_timer": "animation.tyrant_tank_buff_timer.func"
      },
      "scripts": {
        "animate": [
          "c",
          "c.walk",
          "sound_interval",
          "c.tyrant_tank_buff_ai"
        ]
      }
    },

    "component_groups": {
      "godie": {
        "minecraft:instant_despawn": {}
      },
      "skill": {
        "minecraft:is_sheared": {},
        "minecraft:ageable": {
          "duration": 2.25,
          "grow_up": {
            "event": "skill_over"
          }
        }
      },
      "howling": {
        "minecraft:is_stunned": {},
        "minecraft:ageable": {
          "duration": 1.0,
          "grow_up": {
            "event": "howl_over"
          }
        }
      },
      "buff": {
        "minecraft:is_ignited": {}
      },
      "walk": {
        "minecraft:navigation.walk": {
          "can_walk": true,
          "can_pass_doors": true,
          "can_break_doors": true,
          "is_amphibious": true,
          "avoid_damage_blocks": false
        }
      },
      "climb": {
        "minecraft:navigation.climb": {
          "can_path_over_water": true,
          "blocks_to_avoid": [
            "minecraft:barrier"
          ]
        },
        "minecraft:behavior.leap_at_target": {
          "priority": 3,
          "must_be_on_ground": true,
          "set_persistent": true,
          "target_dist": 128,
          "yd": 0.5
        }
      }
    },

    "components": {
      "minecraft:nameable": {
        "always_show": true,
        "allow_name_tag_renaming": false
      },
      "minecraft:type_family": {
        "family": [ "mob", "sdc", "monster","special", "tyrant_tnnk", "tnnk_hard", "boss", "final_boss", "ai" ]
      },
      "minecraft:health": {
        "value": 100,
        "max": 100
      },
      "minecraft:timer": {
        "time": [5, 8],
        "time_down_event": {
          "event": "skill_check",
          "target": "self"
        }
      },
      "minecraft:knockback_resistance": {
        "value": 0.99
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "on_damage": {
              "filters": [
                {
                  "test":"has_damage",
                  "value":"fatal",
                  "operator": "!="
                }
              ],
              "event": "hurting",
              "target": "self"
            }
          },
          {
            "on_damage": {
              "filters": {
                "all_of": [
                  {
                    "test":"has_damage",
                    "value":"fatal",
                    "operator": "="
                  },
                  {
                    "test": "has_tag",
                    "subject": "other",
                    "value": "is_hero"
                  },
                  {
                    "test": "has_damage",
                    "operator": "!=",
                    "value": "projectile"
                  }
                ]
              },
              "event": "melee_tag",
              "target": "self"
            }
          },
          {
            "cause": "fall",
            "deals_damage": false
          }
        ]
      },
      "minecraft:attack": {
        "damage": 5,
        "effect_name": "slowness",
        "effect_duration": 3
      },
      "minecraft:movement": {
        "value": 0.4
      },
      "minecraft:collision_box": {
        "width": 1.5,
        "height": 2.1
      },
      "minecraft:follow_range": {
        "value": 1024
      },
      "minecraft:physics": {},
      "minecraft:jump.static": {},
      "minecraft:movement.basic": {},

      "minecraft:on_target_acquired": {
        "event": "has_target",
        "target": "self"
      },
      "minecraft:on_target_escape": {
        "event": "lost_target",
        "target": "self"
      },

      //behavivors


      "minecraft:behavior.delayed_attack": {
        "priority": 0,
        "attack_once": false,
        "track_target": true,
        "require_complete_path": false,
        "random_stop_interval": 0,
        "reach_multiplier": 6,
        "speed_multiplier": 1,
        "attack_duration": 1.3,
        "hit_delay_pct": 0.45
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 0.8
      },
      "minecraft:behavior.random_look_around": {
        "priority": 7
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 6,
        "probability": 0.02
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1,
        "max_dist": 64,
        "entity_types": {
          "filters": {
            "all_of": [
              {
                "test": "is_family",
                "subject": "other",
                "operator": "!=",
                "value": "monster"
              },
              {
                "test": "is_family",
                "subject": "other",
                "operator": "!=",
                "value": "tool"
              },
              {
                "test": "has_tag",
                "subject": "other",
                "operator": "!=",
                "value": "neutral"
              }
            ]
          }
        }
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "reselect_targets": true,
        "scan_interval": 50,
        "entity_types": [
          {
            "filters": {
              "all_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "player"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "operator": "!=",
                  "value": "tool"
                },
                {
                  "test": "has_tag",
                  "subject": "other",
                  "operator": "!=",
                  "value": "neutral"
                },
                {
                  "test": "has_tag",
                  "subject": "other",
                  "operator": "!=",
                  "value": "no_any_hurt"
                }
              ]
            },
            "max_dist": 48
          }
        ],
        "must_see": false
      }
    },

    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "walk"
          ]
        },
        "queue_command": {
          "command": [
            "scoreboard objectives add tnnk_move dummy tnnk_move",
            "tag @s add is_tnnk",
            "tag @s add 游戏中",
            "tag @s add maper"
          ]
        }
      },
      "has_target": {
        "remove": {
          "component_groups": [
            "walk"
          ]
        },
        "add": {
          "component_groups": [
            "climb"
          ]
        }
      },
      "lost_target": {
        "remove": {
          "component_groups": [
            "climb"
          ]
        },
        "add": {
          "component_groups": [
            "walk"
          ]
        }
      },
      "hurting":{
        "queue_command": {
          "command": [
            "scoreboard players random @s[tag=!sound_interval] wp_random 1 3",

            "execute @s[tag=!sound_interval,scores={wp_random=1}] ~~~ playsound tank.hurt_1 @a ~~~",
            "execute @s[tag=!sound_interval,scores={wp_random=2}] ~~~ playsound tank.hurt_2 @a ~~~",
            "execute @s[tag=!sound_interval,scores={wp_random=3}] ~~~ playsound tank.hurt_3 @a ~~~",

            "scoreboard players reset @s[tag=!sound_interval] idle_time",
            "tag @s[tag=!sound_interval] add sound_interval"
          ]
        }
      },
      "skill_check":{
        "queue_command": {
          "command": [
            "execute @e[family=player,family=!tool,type=!item,tag=!neutral,r=10] ~~~ tag @e[type=coldsink:tyrant_tnnk_ai,r=10] add get_target",
            "scoreboard players random @s[tag=get_target] wp_random 1 10",
            "event entity @s[tag=get_target,scores={wp_random=1..6}] skill",
            "event entity @s[tag=get_target,scores={wp_random=7..10}] howl",
            "tag @e[type=coldsink:tyrant_tnnk_ai] remove get_target"
          ]
        }
      },
      "skill": {
        "add": {
          "component_groups": [
            "skill"
          ]
        }
      },
      "skill_over": {
        "remove": {
          "component_groups": [
            "skill"
          ]
        }
      },
      "howl": {
        "add": {
          "component_groups": [
            "howling",
            "buff"
          ]
        },
        "queue_command": {
          "command": [
            "effect @s slowness 1 7 true",
            "effect @s strength 5 0 true",
            
            "ride @e[type=coldsink:human_ai,r=8] summon_rider coldsink:tnnk_howl_tool",
            "event entity @e[type=coldsink:human_ai,r=8] stop_shoot_run",
            
            "scoreboard players random @s wp_random 1 3",
						"execute @s[scores={wp_random=1}] ~~~ playsound tank.howl_1 @a ~~~",
						"execute @s[scores={wp_random=2}] ~~~ playsound tank.howl_2 @a ~~~",
						"execute @s[scores={wp_random=3}] ~~~ playsound tank.howl_3 @a ~~~",
            
            "effect @e[type=!player,family=player,family=!tool,type=!item,tag=!neutral,r=8] slowness 4 4 true",
            "effect @a[m=!c,family=player,family=!tool,tag=!neutral,r=8] slowness 4 4 true",
            "camerashake add @a[family=player,family=!tool,tag=!neutral,m=!c,r=8] 0.5 2 rotational",
            "event entity @e[type=!player,family=player,family=!tool,type=!item,tag=!neutral,tag=!is_hero,r=8] coldsink:tnnk_howl_control",
            "event entity @a[m=!c,family=player,family=!tool,tag=!neutral,tag=!is_hero,r=8] coldsink:tnnk_howl_control",
            
            "particle nacal_sdc:tyrant_tnnk_blast ~~0.8~",
            "damage @e[family=player,family=!tool,type=!item,tag=!neutral,r=8] 6 suicide entity @s",

            "tag @s add tyrant_buff"
          ]
        }
      },
      "howl_over": {
        "remove": {
          "component_groups": [
            "howling"
          ]
        }
      },
      "buff_over": {
        "remove": {
          "component_groups": [
            "buff"
          ]
        },
        "queue_command": {
          "command": [
            "tag @s remove tyrant_buff"
          ]
        }
      },
      "godie": {
        "add": {
          "component_groups": [
            "godie"
          ]
        }
      },
      "melee_tag": {
        "queue_command": {
          "command": [
            "tag @s add melee_damage"
          ]
        }
      },

      // modapi 触发的加分事件
      
      "addScore_5": {
        "queue_command": {
          "command": [
            "scoreboard players add @s game_score 5"
          ]
        }
      },
      "addScore_10": {
        "queue_command": {
          "command": [
            "scoreboard players add @s game_score 10"
          ]
        }
      },
      "addScore_3": {
        "queue_command": {
          "command": [
            "scoreboard players add @s game_score 3"
          ]
        }
      },
      "addScore_30": {
        "queue_command": {
          "command": [
            "scoreboard players add @s game_score 30"
          ]
        }
      },
      "addScore_50": {
        "queue_command": {
          "command": [
            "scoreboard players add @s game_score 50"
          ]
        }
      },
      "addScore_80": {
        "queue_command": {
          "command": [
            "scoreboard players add @s game_score 80"
          ]
        }
      }
    }
  }
}
